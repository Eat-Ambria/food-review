# =============================================================================
# WHAT THIS FILE IS
#   A template for .env. Copy it to `.env` and fill in the values.
#   .env is git-ignored; never commit real values.
#
# BROWSER-SAFE VALUES ONLY BELOW (anything starting with VITE_ ends up inside
# the public JavaScript bundle, so private keys must NEVER be VITE_ variables).
# =============================================================================

# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push PUBLIC key (safe in the browser). Must equal the VAPID_PUBLIC_KEY
# Edge Function secret. The private key is ONLY a server secret.
VITE_VAPID_PUBLIC_KEY=

# =============================================================================
# SERVER-ONLY SECRETS — do NOT put these in .env.
# They are set in Supabase Dashboard → Edge Functions → Secrets, and listed
# here only so you know which ones exist. See docs/API_SETUP_GUIDE.md.
# =============================================================================
# ALLOWED_ORIGINS=http://localhost:5173            (Phase 1)
# SARVAM_API_KEY=                                   (Phase 4)
# SARVAM_STT_MODEL=saaras:v4                        (Phase 4)
# GEMINI_API_KEY=                                   (Phase 6)
# GEMINI_MODEL=                                     (Phase 6 — confirm in AI Studio)
# EVENT_CALENDAR_API_URL=                           (Phase 5)
# EVENT_CALENDAR_API_KEY=                           (Phase 5)
# CRON_SECRET=                                      (Phase 9, same as Vault secret)
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=mailto:...   (notifications)
